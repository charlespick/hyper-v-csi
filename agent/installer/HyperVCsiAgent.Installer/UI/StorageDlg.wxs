<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="StorageDlg" Width="370" Height="270" Title="Storage Locations">
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="240" Height="15" Transparent="yes" NoPrefix="yes" Text="Storage Locations" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                  Text="Both must be Cluster Shared Volume paths - a local path is only reachable from whichever host currently owns this role." />

        <Control Id="VolumesLabel" Type="Text" X="20" Y="62" Width="280" Height="15" Text="Volumes directory (Agent:CsvVolumesRoot):" />
        <Control Id="VolumesEdit" Type="Edit" X="20" Y="77" Width="320" Height="18" Property="CSVVOLUMESROOT" />

        <Control Id="SnapshotsLabel" Type="Text" X="20" Y="102" Width="280" Height="15" Text="Snapshots directory (Agent:CsvSnapshotsRoot):" />
        <Control Id="SnapshotsEdit" Type="Edit" X="20" Y="117" Width="320" Height="18" Property="CSVSNAPSHOTSROOT" />

        <Control Id="PortLabel" Type="Text" X="20" Y="142" Width="150" Height="15" Text="HTTPS port (Agent:Tls:Port):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="157" Width="60" Height="18" Property="TLSPORT" />
      </Dialog>
    </UI>
  </Fragment>
</Wix>
