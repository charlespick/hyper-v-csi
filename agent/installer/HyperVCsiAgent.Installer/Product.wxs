<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The channel GenerateServerCertificate uses to hand its result to
       ValidateServerCertificate/GrantServiceAccountCertificateAccess/
       WriteAgentConfig - a deferred custom action can't read this back
       through an MSI property (see EffectiveThumbprint). [TempFolder] is
       left as literal text for the MSI engine to resolve at each
       CustomAction's own scheduling moment. -->
  <?define GeneratedCertThumbprintPath = "[TempFolder]HyperVCsiAgent.GeneratedServerCert.thumbprint" ?>
  <!-- ProductVersion here is HyperVCsiMsiVersion (see this project's own
       .wixproj), not the semver Bundle.wixproj feeds to Bundle.wxs's
       Version - the bundle carries meaning, the MSI carries order. Chained
       Visible="no", so it's never seen by a human; it only needs to be a
       valid, distinct-per-build MSI version. -->
  <Package
    Name="Hyper-V CSI Agent"
    Manufacturer="Hyper-V CSI Driver"
    Version="$(var.ProductVersion)"
    UpgradeCode="7F4DC474-BB07-4124-822F-AFB224EE7D2E">

    <!-- Version above is HyperVCsiMsiVersion, a 32-bit build-clock key, not
         the semver - so a same-version reinstall now only happens when two
         builds land in the same build-key second. AllowSameVersionUpgrades
         compensated for the old scheme's more routine collisions; that case
         is gone, so the flag has been dropped with it.

         Default Schedule (afterInstallValidate, sequence 1401, before the
         new product stages anything) rather than the late
         afterInstallExecute this used to carry. The late schedule was
         protecting the service's password, but the actual cause was
         ServiceControl's Remove="uninstall" flag, not the RemoveExistingProducts
         timing - that flag is gone now too (see ServiceControl's own
         comment), so the service survives RemoveExistingProducts at any
         schedule. Deleting the service on a genuine uninstall is instead
         authored explicitly below (RemoveAgentService), guarded so it
         doesn't fire on this same early removal when it's only a step
         inside a chained major upgrade.

         AllowDowngrades="yes" - mutually exclusive with both
         DowngradeErrorMessage and AllowSameVersionUpgrades - retires
         ProductVersion as an ordering gate entirely: one Upgrade row with
         VersionMin=0 and no VersionMax, so RemoveExistingProducts fires
         regardless of version direction. It emits warning WIX1076 (ICE61);
         that's the expected acknowledgement, not a defect - ci.yml's
         WarningsAsErrors is scoped to WIX1148 alone so this one doesn't fail
         the build.

         Downgrade *protection* moves to Burn's own comparison of real
         semantic versions - the only layer positioned to compare them
         correctly. That gate now lives in the bootstrapper
         (SetupMode.Downgrade, WizardViewModel.OnDetectComplete/OnApplyDowngrade);
         this MSI is a pure executor of whatever Burn decided. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Every value below is local to THIS node - see AgentOptions' own remarks
      in HyperVCsiAgent.Core for why. That is also why running this MSI
      unattended (msiexec /quiet PROPERTY=value ...) is the supported way to
      provision a node from Puppet/Ansible/DSC: nothing here needs a value
      shared with, or coordinated across, any other node in the cluster.
    -->
    <Property Id="SERVICEACCOUNT" Secure="yes" />
    <Property Id="SERVICEPASSWORD" Secure="yes" Hidden="yes" />
    <Property Id="CSVVOLUMESROOT" Secure="yes" />
    <Property Id="CSVSNAPSHOTSROOT" Secure="yes" />
    <Property Id="TLSPORT" Value="443" Secure="yes" />
    <Property Id="STORENAME" Value="My" Secure="yes" />
    <Property Id="STORELOCATION" Value="LocalMachine" Secure="yes" />
    <Property Id="SERVERCERTTHUMBPRINT" Secure="yes" />
    <!-- The subject name for GenerateServerCertificate to generate a fresh
         self-signed certificate for, when the Certificate page's selection
         was "will be generated" rather than an already-installed
         certificate - see WizardViewModel.PushVariablesToEngine, which
         never sends both this and SERVERCERTTHUMBPRINT at once. -->
    <Property Id="GENERATECERTSUBJECT" Secure="yes" />
    <!-- Semicolon-separated - the wizard's trusted-clients dialog joins the
         newline-separated text an operator pastes before handing it to MSI,
         since MSI properties collapse embedded newlines. -->
    <Property Id="CLIENTTHUMBPRINTS" Secure="yes" />

    <Binary Id="ActionsExe" SourceFile="$(var.ActionsExePath)" />

    <!--
      Immediate: reading a certificate store does not need elevation, and
      running these before files are even staged means a typo'd thumbprint or
      malformed client fingerprint is caught before anything changes on disk.
      Both no-op (skip via Condition) when their input was not supplied at
      all, so an unattended install that is only staging the service for a
      configuration-management tool to finish later does not fail on
      validation it was never asked to do.
    -->
    <!--
      Deferred and unimpersonated, unlike the validation actions below it:
      importing a fresh self-signed certificate into LocalMachine\My needs
      more than the interactive user's own rights, the same reason
      GrantServiceAccountCertificateAccess is deferred/elevated rather than
      immediate. Always scheduled (Condition is just NOT REMOVE, not
      GENERATECERTSUBJECT) so it also clears out any thumbprint file a
      previous run's generated certificate left behind when this run is
      using an already-installed certificate instead - see
      GenerateServerCertificateCommand's own remarks for why leaving a stale
      file in place would be a real correctness bug, not just clutter.
    -->
    <CustomAction Id="GenerateServerCertificate"
                  BinaryRef="ActionsExe"
                  ExeCommand="generate-server-cert --subject &quot;[GENERATECERTSUBJECT]&quot; --thumbprint-file &quot;$(GeneratedCertThumbprintPath)&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="ValidateServerCertificate"
                  BinaryRef="ActionsExe"
                  ExeCommand="validate-cert --thumbprint &quot;[SERVERCERTTHUMBPRINT]&quot; --store-name &quot;[STORENAME]&quot; --store-location &quot;[STORELOCATION]&quot;"
                  Execute="immediate"
                  Return="check" />

    <!--
      Deferred and unimpersonated, the same "only mutate during the
      already-elevated install/rollback window" rule GenerateServerCertificate
      above follows: creating a brand-new Event Log source needs registry
      rights under HKLM\SYSTEM that [SERVICEACCOUNT] is not guaranteed to
      have, and .NET's own EventLogLoggerProvider swallows that failure
      silently rather than surfacing it - see EnsureEventLogSourceCommand's
      own remarks. Needs no CustomActionData: the source name is fixed, so
      there is nothing here for a wizard page to collect.
    -->
    <CustomAction Id="EnsureEventLogSource"
                  BinaryRef="ActionsExe"
                  ExeCommand="ensure-eventlog-source"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="ValidateClientThumbprints"
                  BinaryRef="ActionsExe"
                  ExeCommand="validate-thumbprints --values &quot;[CLIENTTHUMBPRINTS]&quot;"
                  Execute="immediate"
                  Return="check" />

    <!--
      Deferred and unimpersonated (running as SYSTEM, the elevated context a
      per-machine install already runs under): granting a certificate's
      private key file an ACL entry and writing into ProgramData both need
      more than the interactive user's own rights. Property references in an
      EXE custom action's command line are resolved when MSI *schedules* the
      deferred action - during the same immediate pass these Condition
      attributes evaluate on - not when it later executes, so this needs no
      separate CustomActionData staging step.
    -->
    <!--
      The thumbprint-file flag wins over the thumbprint flag when
      GenerateServerCertificate actually generated a certificate this run
      (SERVERCERTTHUMBPRINT itself stays blank in that case - see
      WizardViewModel.PushVariablesToEngine) - see EffectiveThumbprint.
    -->
    <CustomAction Id="GrantServiceAccountCertificateAccess"
                  BinaryRef="ActionsExe"
                  ExeCommand="grant-cert-access --thumbprint &quot;[SERVERCERTTHUMBPRINT]&quot; --store-name &quot;[STORENAME]&quot; --store-location &quot;[STORELOCATION]&quot; --account &quot;[SERVICEACCOUNT]&quot; --thumbprint-file &quot;$(GeneratedCertThumbprintPath)&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Deferred and unimpersonated for the same reason as the grant above:
      SeServiceLogonRight is a machine-wide LSA policy right, not something
      the interactive user's own token can hand out. Scheduled before
      InstallServices (below) - which is what actually creates the service -
      rather than merely before StartServices, so the right already exists
      for the whole window between service creation and the service actually
      starting.
    -->
    <CustomAction Id="GrantServiceAccountLogonRight"
                  BinaryRef="ActionsExe"
                  ExeCommand="grant-logon-as-service --account &quot;[SERVICEACCOUNT]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Deferred and unimpersonated: modifying the machine's Windows Firewall
      policy needs the elevated context this install already runs under, not
      the interactive user's own token. Without this, the agent's HTTPS
      listener is only reachable from whatever this host's Windows Firewall
      already happens to allow through - confirmed against a real cluster:
      traffic from the install host's own subnet got through by coincidence,
      traffic from the Kubernetes nodes' addresses did not, and both looked
      identical from the agent's side (a plain connection timeout, not a
      clear refusal).
    -->
    <CustomAction Id="OpenFirewallPort"
                  BinaryRef="ActionsExe"
                  ExeCommand="open-firewall-port --port &quot;[TLSPORT]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Undoes OpenFirewallPort on the way out - see its own remarks. -->
    <CustomAction Id="CloseFirewallPort"
                  BinaryRef="ActionsExe"
                  ExeCommand="close-firewall-port"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Deletes the hyperv-csi-agent service - see ServiceControl's own
         comment above for why MSI no longer does this itself, and
         RemoveAgentServiceCommand's remarks for the deletion mechanism.
         Deferred and unimpersonated like the other elevated actions here.
         No rollback counterpart: if a genuine uninstall fails after this
         runs, the service is gone for good. That mirrors CloseFirewallPort
         above and is an accepted, deliberate gap. -->
    <CustomAction Id="RemoveAgentService"
                  BinaryRef="ActionsExe"
                  ExeCommand="remove-service"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      Only the values an operator (or a CM tool) actually supplied end up in
      agent.config.json - see WriteConfigCommand's own remarks for why
      everything else is left for AgentOptions' own defaults to fill in.

      Built up across three short property-setting actions rather than one
      CustomAction: the MSI CustomAction table's Target column caps out at
      255 authored characters (ICE03), and the full write-config command
      line - nine flags, several of them long property references - is
      comfortably over that. A property's own runtime VALUE has no such
      cap, so each step below only needs to stay short as *authored*; the
      final WriteAgentConfig CustomAction's ExeCommand is just "[WRITECONFIGCMD]",
      which is what actually carries the long resolved string at runtime.
    -->
    <Property Id="WRITECONFIGCMD" Secure="yes" />

    <CustomAction Id="SetWriteConfigCmd1" Property="WRITECONFIGCMD"
                  Value="write-config --output &quot;[CommonAppDataFolder]HyperVCsiAgent\agent.config.json&quot; --csv-volumes-root &quot;[CSVVOLUMESROOT]&quot; --csv-snapshots-root &quot;[CSVSNAPSHOTSROOT]&quot;" />
    <CustomAction Id="SetWriteConfigCmd2" Property="WRITECONFIGCMD"
                  Value="[WRITECONFIGCMD] --tls-port &quot;[TLSPORT]&quot; --tls-store-name &quot;[STORENAME]&quot;" />
    <!-- The server-thumbprint-file flag wins over server-thumbprints the same
         way GrantServiceAccountCertificateAccess's thumbprint-file flag does
         - see EffectiveThumbprint. -->
    <CustomAction Id="SetWriteConfigCmd3" Property="WRITECONFIGCMD"
                  Value="[WRITECONFIGCMD] --tls-store-location &quot;[STORELOCATION]&quot; --server-thumbprints &quot;[SERVERCERTTHUMBPRINT]&quot; --client-thumbprints &quot;[CLIENTTHUMBPRINTS]&quot; --server-thumbprint-file &quot;$(GeneratedCertThumbprintPath)&quot;" />

    <CustomAction Id="WriteAgentConfig"
                  BinaryRef="ActionsExe"
                  ExeCommand="[WRITECONFIGCMD]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      NOT REMOVE on every one of these: the MSI properties they key off
      (SERVERCERTTHUMBPRINT, SERVICEACCOUNT, CSVVOLUMESROOT, ...) come from
      Burn Variables marked Persisted="yes" in Bundle.wxs, so a later
      uninstall run still has last install's values sitting there even
      though the bootstrapper's own BeginUninstall deliberately never pushes
      new ones. Without NOT REMOVE, these all still evaluate truthy and fire
      again during REMOVE=ALL - validating a certificate that isn't being
      installed, granting access nothing needs anymore, and rewriting a
      config file the uninstall is about to leave behind anyway.
    -->
    <InstallExecuteSequence>
      <Custom Action="GenerateServerCertificate" After="InstallInitialize" Condition="NOT REMOVE" />
      <!-- No ordering dependency on GenerateServerCertificate or any other
           elevated action here - registering the Event Log source is
           independent of certificates, config and the firewall alike, so
           this just needs to land somewhere in the elevated sequence before
           the service can plausibly start (InstallServices, further down). -->
      <Custom Action="EnsureEventLogSource" After="GenerateServerCertificate" Condition="NOT REMOVE" />
      <Custom Action="ValidateServerCertificate" Before="InstallValidate" Condition="SERVERCERTTHUMBPRINT AND NOT REMOVE" />
      <Custom Action="ValidateClientThumbprints" After="ValidateServerCertificate" Condition="CLIENTTHUMBPRINTS AND NOT REMOVE" />
      <!-- SERVERCERTTHUMBPRINT OR GENERATECERTSUBJECT, not SERVERCERTTHUMBPRINT
           alone: the generate case leaves SERVERCERTTHUMBPRINT itself blank
           (see WizardViewModel.PushVariablesToEngine) - GrantServiceAccountCertificateAccess
           still needs to run, it just resolves the actual thumbprint from
           GenerateServerCertificate's file instead (EffectiveThumbprint). -->
      <Custom Action="GrantServiceAccountCertificateAccess" After="InstallFiles" Condition="(SERVERCERTTHUMBPRINT OR GENERATECERTSUBJECT) AND SERVICEACCOUNT AND NOT REMOVE" />
      <Custom Action="GrantServiceAccountLogonRight" Before="InstallServices" Condition="SERVICEACCOUNT AND NOT REMOVE" />
      <!-- Only when the agent is actually being configured (same gate
           WriteAgentConfig uses below) - an unattended install that is only
           staging the service exe has no port to open yet either. -->
      <Custom Action="OpenFirewallPort" After="GrantServiceAccountLogonRight" Condition="CSVVOLUMESROOT AND NOT REMOVE" />
      <Custom Action="SetWriteConfigCmd1" After="GrantServiceAccountCertificateAccess" Condition="CSVVOLUMESROOT AND NOT REMOVE" />
      <Custom Action="SetWriteConfigCmd2" After="SetWriteConfigCmd1" Condition="CSVVOLUMESROOT AND NOT REMOVE" />
      <Custom Action="SetWriteConfigCmd3" After="SetWriteConfigCmd2" Condition="CSVVOLUMESROOT AND NOT REMOVE" />
      <Custom Action="WriteAgentConfig" After="SetWriteConfigCmd3" Condition="CSVVOLUMESROOT AND NOT REMOVE" />
      <!-- REMOVE AND NOT UPGRADINGPRODUCTCODE, not just REMOVE: this custom
           action is a raw imperative side effect keyed by a fixed rule name,
           not an MSI-tracked resource like ServiceControl's service, so
           MajorUpgrade's Schedule="afterInstallExecute" (see its own remarks)
           does not protect it the same way - the new product's InstallServices
           reuses the existing, ref-counted service, but OpenFirewallPort and
           CloseFirewallPort both just add/remove "Hyper-V CSI Agent" by name
           with no ref-counting at all. Confirmed the hard way: with only
           Condition="REMOVE", the new product's OpenFirewallPort (which now
           runs first) got its rule deleted moments later by the old product's
           own CloseFirewallPort (running afterward as part of the same
           RemoveExistingProducts), leaving every upgraded node with no
           inbound rule until someone noticed the controller's probes were
           timing out. UPGRADINGPRODUCTCODE is set on the product being
           removed specifically when that removal is a chained major-upgrade
           step rather than a real, standalone uninstall - excluding that
           case here leaves a genuine `msiexec /x` still closing the port
           behind it, same as always. -->
      <Custom Action="CloseFirewallPort" Before="RemoveFiles" Condition="REMOVE AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Same guard as CloseFirewallPort above, same reason: a named
           service in the SCM is an imperative side effect MSI's component
           reference-counting can't see. Before="RemoveFiles" isn't a real
           dependency - ActionsExe is a Binary table stream MSI extracts to
           temp, not an installed file - it just keeps both imperative
           teardowns together before anything on disk disappears. -->
      <Custom Action="RemoveAgentService" Before="RemoveFiles" Condition="REMOVE AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HyperVCsiAgent" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentRef Id="ServiceExeComponent" />
    </Feature>

    <!-- The WPF Bootstrapper Application (HyperVCsiAgent.Installer.Bootstrapper,
         chained via HyperVCsiAgent.Installer.Bundle) is the supported
         interactive front end now - Burn drives this MSI silently, so
         InstallUISequence never runs. WixUI_Minimal (welcome, license,
         progress, exit only - no per-field dialogs) is what a direct
         `msiexec /i` still shows, which is an unsupported, expert-only path
         kept working only because WixUI_Minimal costs nothing to keep. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.ServicePublishDir)**">
        <Exclude Files="$(var.ServicePublishDir)HyperVCsiAgent.Service.exe" />
        <!-- Belt-and-braces with DebugType=none (agent/Directory.Build.props),
             which is conditioned on Release: a Debug build still produces
             .pdbs, and this exclusion keeps them out of the package
             regardless of which configuration produced it. -->
        <Exclude Files="$(var.ServicePublishDir)**\*.pdb" />
        <!-- These four are authored explicitly below instead, as
             <File CompanionFile="ServiceExe"> in ServiceExeComponent - a
             component's keypath file can't itself be a companion, so they
             can't stay in this glob harvest. Excluded here so each is
             authored exactly once. -->
        <Exclude Files="$(var.ServicePublishDir)HyperVCsiAgent.Service.deps.json" />
        <Exclude Files="$(var.ServicePublishDir)HyperVCsiAgent.Service.runtimeconfig.json" />
        <Exclude Files="$(var.ServicePublishDir)appsettings.json" />
        <Exclude Files="$(var.ServicePublishDir)System.Diagnostics.EventLog.Messages.dll" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!--
    The service exe gets its own Component, outside the AgentComponents
    glob-harvest, purely so ServiceInstall/ServiceControl can attach to it -
    WiX requires both on the component that owns the service's executable.
  -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Guid is fixed (not "*") so this component's identity survives a
           rebuild, even though its file set below changes from one file to
           five - normally a reason for a new Guid, but the early
           RemoveExistingProducts (1401) removes the old product entirely
           before the new one installs anything, so old and new definitions
           of this Guid never coexist. -->
      <Component Id="ServiceExeComponent" Guid="9D6E9F9C-9F2E-4C7D-9E9E-2B7C7B9F6D01">
        <File Id="ServiceExe" Source="$(var.ServicePublishDir)HyperVCsiAgent.Service.exe" KeyPath="yes" />

        <!-- CompanionFile="ServiceExe" rather than the glob harvest above:
             a component's keypath file (ServiceExe, above) can't itself
             carry CompanionFile, so this makes these four follow
             ServiceExe's own version compare instead of falling back to a
             timestamp heuristic - a distinction that only matters if
             RemoveExistingProducts is ever moved later than its current
             early schedule. -->
        <File Id="ServiceDepsJson"
              Source="$(var.ServicePublishDir)HyperVCsiAgent.Service.deps.json"
              CompanionFile="ServiceExe" />
        <File Id="ServiceRuntimeConfigJson"
              Source="$(var.ServicePublishDir)HyperVCsiAgent.Service.runtimeconfig.json"
              CompanionFile="ServiceExe" />
        <File Id="AppSettingsJson"
              Source="$(var.ServicePublishDir)appsettings.json"
              CompanionFile="ServiceExe" />
        <File Id="EventLogMessagesDll"
              Source="$(var.ServicePublishDir)System.Diagnostics.EventLog.Messages.dll"
              CompanionFile="ServiceExe" />

        <!-- Start="demand", not "auto": this service is meant to be run
             under cluster management (or otherwise started deliberately per
             node), not launched unconditionally by SCM on every boot. -->
        <ServiceInstall
          Id="ServiceInstaller"
          Name="hyperv-csi-agent"
          DisplayName="Hyper-V CSI Agent"
          Description="Provisions and attaches VHDX-backed persistent volumes for the Hyper-V CSI driver."
          Type="ownProcess"
          Start="demand"
          ErrorControl="normal"
          Account="[SERVICEACCOUNT]"
          Password="[SERVICEPASSWORD]" />

        <!-- Stop only. No Remove="uninstall": that flag is what makes MSI
             delete the service during an uninstall, and deleting a service
             installed with a password can't be rolled back - MSI has no way
             to restore a password once removed ("stored in a protected part
             of the system", per the ServiceInstall table's own remark).
             Deletion is instead a deliberate, conditioned custom action
             (RemoveAgentService, below). Install never starts the service -
             see the Start="demand" note above. -->
        <ServiceControl
          Id="ServiceControlStop"
          Name="hyperv-csi-agent"
          Stop="both"
          Wait="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
