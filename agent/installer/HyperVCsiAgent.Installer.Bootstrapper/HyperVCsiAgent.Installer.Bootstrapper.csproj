<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <!-- Disabled, not enabled: UseWPF and UseWindowsForms together (the
         latter only for DirectoryObjectPickerDialog) each contribute their
         own implicit global usings for same-named types - UserControl,
         Brush - and having both in scope unqualified is ambiguous. Every
         file below imports exactly the namespaces it needs instead. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Tulpep.ActiveDirectoryObjectPicker's DirectoryObjectPickerDialog
         (the Service Account page's "Select..." button) wraps the AD
         object-picker COM dialog as a System.Windows.Forms.CommonDialog -
         the only WinForms surface this otherwise-WPF app needs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Burn v5 launches the BA as its own child process (out-of-process
         hosting) rather than loading a DLL into the engine, so this has to be
         a real, self-contained exe - see HyperVCsiAgent.Installer.Bundle's
         own remarks for how it gets harvested into the bundle as a payload
         group. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Left enabled (WPF's own default), not disabled: InvariantGlobalization
         crashes WPF's data-binding engine the moment a window with any
         binding actually shows - XmlLanguage.GetSpecificCulture cannot
         resolve "en-us" with only the invariant culture available. This
         was set true from the initial scaffold on the mistaken assumption
         that it was a safe size/startup optimization the way it is for the
         other self-contained exes in this repo (HyperVCsiAgent.Service,
         HyperVCsiAgent.Installer.Actions - neither of which is a WPF app);
         confirmed via a real crash (System.InvalidOperationException:
         Cannot find non-neutral culture related to 'en-us') the first time
         a window with a live binding was actually shown rather than just
         built. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned, not floating: the event-arg shapes and IEngine.Plan's single-
         argument signature used throughout this project were verified
         against 5.0.2 specifically (WiX's own main-branch source has since
         diverged, e.g. adding a BundleScope parameter to Plan that 5.0.2
         does not have) - a floating restore could silently break that. -->
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
    <!-- Same package and version the agent service itself uses for CIM -
         see HyperVCsiAgent.Service.csproj - so the Prerequisites page's
         Hyper-V role check goes through the same CIM path as the agent's
         own runtime checks rather than shelling out to PowerShell. -->
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <!-- Wraps objsel.dll's IDsObjectPicker COM dialog (the same picker
         ADUC uses) rather than hand-rolling that COM interop directly -
         mature, MS-PL, ~1M downloads, no other dependencies. -->
    <PackageReference Include="Tulpep.ActiveDirectoryObjectPicker" Version="3.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HyperVCsiAgent.Core\HyperVCsiAgent.Core.csproj" />
  </ItemGroup>

  <!-- Linked, not copied: the MSI's own license dialog (until the WXS
       dialogs are retired) and this wizard's Welcome/License page have to
       keep showing the exact same text, so there is only one License.rtf on
       disk for both to reference. -->
  <ItemGroup>
    <EmbeddedResource Include="..\HyperVCsiAgent.Installer\License.rtf" LogicalName="License.rtf" Link="Assets\License.rtf" />
  </ItemGroup>

</Project>
