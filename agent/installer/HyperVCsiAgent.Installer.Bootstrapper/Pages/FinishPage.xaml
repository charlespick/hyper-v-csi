<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StaticResource is resolved from this file's own resource scope, not
         inherited from MainWindow.xaml's - see PrerequisitesPage.xaml for
         the same local-converter pattern for the same reason. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding FinishTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        <Button Content="Open Log..." HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding OpenLogCommand}"
                Visibility="{Binding ShowOpenLogButton, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
