<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding ProgressTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
        <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding OverallProgressPercentage, Mode=OneWay}" />
        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
