<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ReadyToInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StaticResource is resolved from this file's own resource scope, not
         inherited from MainWindow.xaml's - see PrerequisitesPage.xaml for
         the same local-converter pattern for the same reason. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Ready to Install" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <!-- SetupSummary - "Upgrading Hyper-V CSI Agent from X to Y on
             this node." for Upgrade, the equivalent line for Install/Repair.
             Never Downgrade's text: that mode is redirected to
             DowngradeBlockedPage before this page is ever reachable. -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" Text="{Binding SetupSummary}" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
            <Run Text="Review these settings, then click" />
            <Run Text="{Binding InstallButtonLabel, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="to continue." />
        </TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Service account:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding ServiceAccount}" />
                <!-- Labelled, not silently pre-filled - the installer upgrade
                     validation checklist's check 3 is a human confirming
                     this reads as detected, not typed. -->
                <TextBlock Text=" (carried over)" FontStyle="Italic" Foreground="#FF6E6E6E"
                           Visibility="{Binding ServiceAccountCarriedOver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Volumes directory:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding CsvVolumesRoot}" />
                <TextBlock Text=" (carried over)" FontStyle="Italic" Foreground="#FF6E6E6E"
                           Visibility="{Binding CsvVolumesRootCarriedOver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Snapshots support:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SnapshotsEnabled}" Value="True">
                                    <Setter Property="Text" Value="{Binding CsvSnapshotsRoot}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text=" (carried over)" FontStyle="Italic" Foreground="#FF6E6E6E"
                           Visibility="{Binding CsvSnapshotsRootCarriedOver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Server certificate:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding CertificateSummary}" TextWrapping="Wrap" />
                <TextBlock Text=" (carried over)" FontStyle="Italic" Foreground="#FF6E6E6E"
                           Visibility="{Binding ServerCertificateCarriedOver, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="HTTPS port:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TlsPort}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Trusted clients:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ClientThumbprintList.Count, StringFormat={}{0} thumbprint(s)}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Add to cluster:" FontWeight="SemiBold" Margin="0,0,0,6"
                       Visibility="{Binding IsClusterMember, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RegisterClusterResource}" Margin="0,0,0,6"
                       Visibility="{Binding IsClusterMember, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </StackPanel>
</UserControl>
