<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ReadyToInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StaticResource is resolved from this file's own resource scope, not
         inherited from MainWindow.xaml's - see PrerequisitesPage.xaml for
         the same local-converter pattern for the same reason. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Ready to Install" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Review these settings, then click Install to set up the Hyper-V CSI Agent." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Service account:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceAccount}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Volumes directory:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CsvVolumesRoot}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Snapshots support:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Disabled" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SnapshotsEnabled}" Value="True">
                                <Setter Property="Text" Value="{Binding CsvSnapshotsRoot}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Server certificate:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServerCertThumbprint}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="HTTPS port:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TlsPort}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Trusted clients:" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ClientThumbprintList.Count, StringFormat={}{0} thumbprint(s)}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Add to cluster:" FontWeight="SemiBold" Margin="0,0,0,6"
                       Visibility="{Binding IsClusterMember, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RegisterClusterResource}" Margin="0,0,0,6"
                       Visibility="{Binding IsClusterMember, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </StackPanel>
</UserControl>
