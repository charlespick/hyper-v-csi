<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.TrustedClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Trusted Clients" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Fingerprints of the client certificates allowed to call this agent." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Client certificate thumbprints - separate more than one with a semicolon (;), such as during a rotation:" />
        <TextBox Text="{Binding ClientThumbprints, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
