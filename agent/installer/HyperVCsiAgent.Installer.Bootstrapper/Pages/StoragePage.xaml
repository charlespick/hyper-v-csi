<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Storage Locations" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Both must be Cluster Shared Volume paths - a local path is only reachable from whichever host currently owns this role." />

        <TextBlock Text="Volumes directory (Agent:CsvVolumesRoot):" Margin="0,0,0,4" />
        <TextBox Text="{Binding CsvVolumesRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Snapshots directory (Agent:CsvSnapshotsRoot):" Margin="0,0,0,4" />
        <TextBox Text="{Binding CsvSnapshotsRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="HTTPS port (Agent:Tls:Port):" Margin="0,0,0,4" />
        <TextBox Text="{Binding TlsPort, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
