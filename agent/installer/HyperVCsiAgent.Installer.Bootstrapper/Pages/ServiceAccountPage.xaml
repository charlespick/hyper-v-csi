<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ServiceAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StaticResource is resolved from this file's own resource scope, not
         inherited from MainWindow.xaml's - see PrerequisitesPage.xaml for
         the same local-converter pattern for the same reason. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Service Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Specify the domain account the Hyper-V CSI Agent service will run as." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="This account must have permissions to manage virtual machines and cluster resources." />
        <TextBlock Text="Username:" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ServiceAccount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Select..." Width="80" Click="SelectButton_Click" />
        </Grid>

        <TextBlock Text="Password:" Margin="0,0,0,4" />

        <!-- An existing account was detected for this node and its password
             was left untouched - shown disabled and already "filled" rather
             than an empty box demanding new input, since there is nothing
             real to put in it: SCM has no API that gives the password back. -->
        <Grid Visibility="{Binding PasswordLocked, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox Grid.Column="0" Password="&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;" IsEnabled="False" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Update Password..." Width="130" Command="{Binding UnlockPasswordCommand}" />
        </Grid>

        <StackPanel Visibility="{Binding PasswordUnlocked, Converter={StaticResource BoolToVis}}">
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,12" />

            <TextBlock Text="Confirm password:" Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
            <TextBlock Text="Passwords do not match." Foreground="Red" Margin="0,4,0,0"
                       Visibility="{Binding ShowPasswordMismatch, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
