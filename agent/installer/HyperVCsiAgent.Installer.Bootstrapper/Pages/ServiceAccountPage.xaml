<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ServiceAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Service Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Specify the domain account the Hyper-V CSI Agent service runs as." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Needs Hyper-V Administrators rights on every host and Failover Cluster permissions for forced detach." />
        <TextBlock Text="Username:" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ServiceAccount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Select..." Width="80" Click="SelectButton_Click" />
        </Grid>

        <TextBlock Text="Password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
    </StackPanel>
</UserControl>
