<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ServiceAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Service Account" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Specify the domain account the Hyper-V CSI Agent service runs as." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Service account (DOMAIN\user) - needs Hyper-V Administrators rights on every host and Failover Cluster permissions for forced detach:" />
        <TextBox Text="{Binding ServiceAccount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Password:" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
    </StackPanel>
</UserControl>
