<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ClusteringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Clustering" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="You should configure the cluster role only after the agent has been installed on every other node in the cluster." />

        <CheckBox IsChecked="{Binding RegisterClusterResource}" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" Width="480"
                       Text="Configure the cluster role during installation" />
        </CheckBox>
    </StackPanel>
</UserControl>
