<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.ClusteringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Clustering" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="This host is a member of a failover cluster." />

        <CheckBox IsChecked="{Binding RegisterClusterResource}" VerticalAlignment="Top">
            <TextBlock TextWrapping="Wrap" Width="480"
                       Text="The agent will need to run clustered in a production environment. You should add the role to the cluster when installing the agent on the final node in the cluster." />
        </CheckBox>
    </StackPanel>
</UserControl>
