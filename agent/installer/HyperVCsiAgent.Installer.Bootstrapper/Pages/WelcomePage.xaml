<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Hyper-V CSI Agent Setup" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Please review the license terms before installing the Hyper-V CSI Agent." />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <RadioButton x:Name="AcceptButton" GroupName="License" Content="I accept the terms in the License Agreement"
                         Checked="LicenseChoice_Changed" />
            <RadioButton x:Name="DeclineButton" GroupName="License" Content="I do not accept the terms in the License Agreement"
                         IsChecked="True" Checked="LicenseChoice_Changed" Margin="0,4,0,0" />
        </StackPanel>

        <Border BorderBrush="#FFACACAC" BorderThickness="1">
            <RichTextBox x:Name="LicenseText" IsReadOnly="True" IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" />
        </Border>
    </DockPanel>
</UserControl>
