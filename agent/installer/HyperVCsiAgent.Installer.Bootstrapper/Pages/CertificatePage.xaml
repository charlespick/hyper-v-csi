<UserControl x:Class="HyperVCsiAgent.Installer.Bootstrapper.Pages.CertificatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Server Certificate" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="The certificate must already be installed on this host - Setup only pins it by thumbprint, it does not import one for you." />

        <TextBlock Text="DNS name callers use to reach this agent (Agent:Tls:HostName):" Margin="0,0,0,4" />
        <TextBox Text="{Binding TlsHostName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Server certificate thumbprint:" Margin="0,0,0,4" />
        <TextBox Text="{Binding ServerCertThumbprint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Certificate store name:" Margin="0,0,0,4" />
                <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Certificate store location:" Margin="0,0,0,4" />
                <TextBox Text="{Binding StoreLocation, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
