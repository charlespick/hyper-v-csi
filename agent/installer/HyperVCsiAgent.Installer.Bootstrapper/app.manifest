<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="HyperVCsiAgent.Installer.Bootstrapper.app"/>

  <!--
    requireAdministrator, not asInvoker (the SDK default this file
    otherwise replaces): this is a per-machine bundle, and leaving the BA
    process asInvoker only gets it elevated for Burn's own Apply() step at
    the very end of the wizard. Everything before that - most concretely
    the Certificate page's "Generate new self-signed certificate..."
    button, which imports straight into LocalMachine\My - runs unelevated
    and fails. Elevating the whole process up front (one UAC prompt at
    launch, standard for setup.exe-style installers) is what makes that
    button work regardless of which page it's clicked from.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!--
    No <application>/<windowsSettings> DPI block here: with
    UseWindowsForms true, the SDK (WFO0003) wants DPI mode set through the
    ApplicationHighDpiMode project property instead of the manifest, so
    that's where it's configured - see this project's csproj.
  -->
</assembly>
